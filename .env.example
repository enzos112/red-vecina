# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# Aquí va solo configuración técnica: los parámetros de negocio (P1 a P20) viven en la base.

# desarrollo | produccion
ENTORNO=desarrollo

# Desarrollo: SQLite (si lo dejas vacío se usa backend/red_vecina.db).
# Producción: la cadena de Neon con pooling y SSL, p. ej.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/red_vecina?sslmode=require
DATABASE_URL=sqlite:///./red_vecina.db

# Clave para firmar sesiones. En producción, genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=solo-para-desarrollo-cambiar-en-produccion

# Lector de boletas: manual | gemini | anthropic
LECTOR_PROVEEDOR=manual
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opcionales: modelo de cada proveedor, espera máxima y confianza mínima por campo.
# LECTOR_GEMINI_MODELO=gemini-3.8-flash
# LECTOR_ANTHROPIC_MODELO=claude-opus-5-5
# LECTOR_TIMEOUT_SEGUNDOS=30
# LECTOR_CONFIANZA_MINIMA=0.8

# WhatsApp del equipo, impreso en la tarjeta de 3 pasos de la caja (opcional).
CONTACTO_WHATSAPP=+56 9 0000 0000

# Primer administrador (comando base) y contraseñas iniciales de los usuarios que crean
# los comandos de carga (base y demo). Mínimo 10 caracteres. Cámbialas al publicar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPERADOR_PASSWORD=
COMERCIO_PASSWORD=
