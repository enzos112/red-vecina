# Copia este archivo como .env.produccion y complétalo. Nunca lo subas al repositorio.
# Lo usa .\produccion.cmd para correr comandos contra Neon desde tu PC, y para levantar la
# imagen en modo producción en tu PC (.\produccion.cmd local).
# Son las mismas variables que cargas en Render.

ENTORNO=produccion

# Cadena de Neon CON pooling (el host termina en -pooler) y SSL.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# manual | gemini | anthropic
LECTOR_PROVEEDOR=manual
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

CONTACTO_WHATSAPP=

# Primer administrador (lo crea el comando base). Contraseñas de 10 caracteres o más.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Solo para los datos de demostración (usuarios operador y comercios de prueba).
OPERADOR_PASSWORD=
COMERCIO_PASSWORD=
